generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  reviews   Review[]
  ratings   Rating[]
  bookmarks Bookmark[]
}

model Anime {
  id        String   @id @default(cuid())
  title     String   @unique
  summary   String
  creator   String
  ep_count  Int
  season    Int
  image     String
  genre     String

  format    String?
  eps_dur   String?
  studios   String?
  producers String?

  reviews      Review[]
  ratings      Rating[]
  bookmarks    Bookmark[]
  character    Character[]
  staffCredits AnimeStaff[]
}


model Character {
  id        String  @id @default(cuid())
  name      String  @unique
  role      String?
  image     String
  desc      String?
  stats     Int?
  abilities String?
  strength  String?
  weakness  String?

  anime   Anime  @relation(fields: [animeId], references: [id])
  animeId String
}

model Episode {
  id         String   @id @default(cuid())
  title      String
  desc       String
  eps_num    Int?
  season_num Int?
  summary    String
  air_date   DateTime
  image      String
}

model Staff {
  id       String  @id @default(cuid())
  name     String  @unique
  image    String?
  bio      String?
  language String?
  siteUrl  String?

  credits AnimeStaff[]
}

model AnimeStaff {
  id        String  @id @default(cuid())
  animeId   String
  staffId   String
  role      String
  roleGroup String?
  isMain    Boolean @default(false)
  sortOrder Int?

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([animeId])
  @@index([staffId])
  @@unique([animeId, staffId, role])
}

model Review {
  id         String   @id @default(cuid())
  content    String
  reviewDate DateTime @default(now())
  animeId    String
  userId     String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([animeId, userId])
}

model Rating {
  id         String   @id @default(cuid())
  animeId    String
  userId     String
  score      Float
  ratingDate DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([animeId, userId])
}

model Bookmark {
  id       String   @id @default(cuid())
  animeId  String
  userId   String
  saveDate DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, userId])
}
