// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime? // <- I'd remove the default(now()) or it's always "verified"
  password      String
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  reviews   Review[]
  ratings   Rating[]
  bookmarks Bookmark[]
}

model Anime {
  id       String   @id @default(cuid())
  title    String   @unique
  summary  String
  creator  String
  ep_count Int
  season   Int
  image    String
  genre    String

  reviews   Review[]
  ratings   Rating[]
  bookmarks Bookmark[]
  character   Character[]
}

model Character {
  id        String @id @default(cuid())
  name      String
  role      String
  image     String
  desc      String
  stats     Int
  abilities String
  strength  String
  weakness  String

  anime   Anime[]
}

model Episode {
  id        String   @id @default(cuid())
  title     String
  desc      String
  eps_num   Int?
  season_num Int?
  summary   String
  air_date  DateTime
  image     String
}

model Review {
  id         String   @id @default(cuid())
  content    String
  reviewDate DateTime @default(now())
  animeId    String
  userId     String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([animeId, userId])
}

model Rating {
  id         String   @id @default(cuid())
  animeId    String
  userId     String
  score      Float
  ratingDate DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([animeId, userId])
}

model Bookmark {
  id       String   @id @default(cuid())
  animeId  String
  userId   String
  saveDate DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, userId])
}
